# SuperOpenGym — development settings. ./dev.sh copies this to .env.dev on the first run;
# edit .env.dev, not this file. Every variable is documented in .env.example.

# The dev server's address. Passkeys work on localhost without HTTPS.
RP_ID=localhost
ORIGIN=http://localhost:8095
RP_NAME=SuperOpenGym (dev)

# Password sign-in as well as passkeys, so a profile can be made without a passkey device —
# and so a browser can sign in to create the phone's pairing code.
PASSWORD_LOGIN=1

# Spanish for the sign-in screen and for every profile that has not picked a language yet.
DEFAULT_LANG=es

# A dev stack has nothing to protect from itself: no throttling by proxy headers.
TRUST_PROXY=0
