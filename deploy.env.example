# ./deploy.sh settings. Copy to deploy.env (gitignored) and fill in.

# SSH destination of the VPS (key-based login; deploy.sh never asks for a password).
VPS_SSH=usuario@mi-vps.example.com
# Where the stack lives on the VPS: docker-compose.yml, .env, data/, media/, backups/.
VPS_DIR=/opt/superopengym
# The public HTTPS name the VPS's Nginx serves SuperOpenGym on.
DOMAIN=gym.example.com
# Loopback port on the VPS that the web container listens on and Nginx proxies to.
# Pick one nothing else on the VPS uses.
WEB_PORT=8095

# GitHub account the images are pushed under (ghcr.io/<user>/superopengym-api / -web).
GHCR_USER=X3M4
# Pushing uses `gh auth token` on this machine, which needs the write:packages scope:
#   gh auth refresh -h github.com -s write:packages
# The VPS pulls with a separate token that can do nothing else: a classic PAT with only
# read:packages. Leave empty if the packages are public.
GHCR_PULL_TOKEN=

# CPU architecture of the VPS: linux/amd64 (most VPS) or linux/arm64 (Ampere, Graviton…).
PLATFORM=linux/amd64
# How many data backups deploy.sh keeps on the VPS (one is taken before every deploy).
BACKUPS_KEEP=10
